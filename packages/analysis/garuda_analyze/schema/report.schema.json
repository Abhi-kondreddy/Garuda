{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://garuda.local/schema/report.schema.json",
  "title": "Garuda Analysis Report",
  "type": "object",
  "required": [
    "version",
    "createdAt",
    "sourcePath",
    "sourceName",
    "durationSec",
    "fps",
    "scores",
    "visual",
    "audio",
    "timeline",
    "transcript"
  ],
  "properties": {
    "version": { "type": "integer" },
    "scoringVersion": { "type": "string" },
    "createdAt": { "type": "string" },
    "sourcePath": { "type": "string" },
    "sourceName": { "type": "string" },
    "durationSec": { "type": "number", "minimum": 0 },
    "fps": { "type": "number", "minimum": 0 },
    "width": { "type": "integer", "minimum": 0 },
    "height": { "type": "integer", "minimum": 0 },
    "scores": {
      "type": "object",
      "required": ["hook", "interestingness", "colorEvenness", "visualQuality", "audioQuality", "overall"],
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "visual": { "type": "object" },
    "audio": { "type": "object" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "interestingness"],
        "properties": {
          "t": { "type": "number" },
          "interestingness": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "transcript": { "type": "array" },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "value", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "provenance": { "type": "object" },
    "diagnostics": { "type": "object" }
  }
}
